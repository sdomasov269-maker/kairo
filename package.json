{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "description": "A cinematic anime discovery interface.",
  "scripts": {
    "test:playback": "node --import=./scripts/server-only-test-register.mjs --experimental-strip-types --test src/lib/playback/descriptor.test.ts src/lib/playback/hls-policy.test.ts src/lib/playback/autonext.test.ts src/lib/playback/skip-segments.test.ts src/lib/playback/time.test.ts src/lib/playback/quality.test.ts src/lib/watch-progress/policy.test.ts src/lib/watch-progress/selectors.test.ts src/server/playback/provider-manager.test.ts src/server/playback/translation-matching.test.ts",
    "test:header": "node scripts/accept-header-localization.mjs",
    "dev": "next dev --webpack",
    "dev:all": "concurrently -k -n WEB,PROVIDER \"npm run dev\" \"npm run provider:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import=./scripts/server-only-test-register.mjs --experimental-strip-types --test --test-isolation=none src/lib/catalog/catalog.test.ts src/lib/catalog/roulette.test.ts src/lib/anime/local-first.test.ts src/lib/anime-titles/anime-titles.test.ts src/lib/anime-titles/public-list.test.ts src/lib/anime-titles/retry.test.ts src/lib/anime-index/anime-index.test.ts src/lib/db/prisma-diagnostics.test.ts src/lib/anilist/index-retry.test.ts src/lib/watch-route.test.ts src/domain/watch/episodes.test.ts src/server/validation/comment.test.ts src/server/services/kodik.service.test.ts src/server/services/kodik/provider.test.ts src/server/services/kodik/detail-episodes.test.ts src/server/media-providers/providers.test.ts src/server/media-providers/manifest-sync.test.ts src/server/media-providers/verifier.test.ts src/server/media-providers/adapters/aniliberty/client.test.ts src/server/media-providers/adapters/aniliberty/mapper.test.ts src/server/media-providers/adapters/aniliberty/adapter.test.ts src/server/media-providers/adapters/aniliberty/extra.test.ts src/server/media-providers/adapters/kodik/client.test.ts src/server/media-providers/adapters/kodik/mapper.test.ts src/server/media-providers/adapters/kodik/adapter.test.ts",
    "titles:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-anime-localized-titles.ts",
    "anime:index:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-anime-index.ts",
    "titles:trace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/trace-anime-title.ts",
    "titles:stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/anime-title-stats.ts",
    "localization:ru:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/localization/ru-audit.ts",
    "localization:ru:enrich": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-anime-localized-titles.ts --locale=ru --only-missing --resume",
    "localization:ru:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/localization/ru-verify.ts",
    "localization:ru:coverage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/localization/ru-coverage.ts",
    "episodes:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/episodes-sync.ts",
    "episodes:generate-missing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/generate-missing-episodes.ts",
    "episodes:stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/episodes-stats.ts",
    "episodes:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/episodes-check.ts",
    "episodes:seed-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/episodes-seed-demo.ts",
    "providers:manifest:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-manifest-validate.ts",
    "providers:manifest:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-manifest-sync.ts",
    "providers:probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-probe.ts",
    "providers:catalog:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-catalog-validate.ts",
    "providers:catalog:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-catalog-report.ts",
    "providers:aniliberty:inspect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-inspect.ts",
    "providers:aniliberty:inspect-search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-inspect-search.ts",
    "providers:aniliberty:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-search.ts",
    "providers:aniliberty:show": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-show.ts",
    "providers:aniliberty:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-sync.ts",
    "providers:aniliberty:updates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-aniliberty-updates.ts",
    "providers:kodik:inspect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-inspect.ts",
    "providers:kodik:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-health.ts",
    "providers:kodik:diagnose": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-diagnose.ts",
    "kodik:test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-kodik.ts",
    "providers:kodik:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-blocked.ts search",
    "providers:kodik:show": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-blocked.ts show",
    "providers:kodik:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-blocked.ts sync",
    "providers:kodik:updates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-kodik-blocked.ts updates",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:reset:dangerous": "prisma migrate reset",
    "provider:dev": "py -3.12 -m uvicorn --app-dir services/anime-provider app:app --host 127.0.0.1 --port 8787",
    "provider:health": "node scripts/dev/check-provider.mjs"
  },
  "dependencies": {
