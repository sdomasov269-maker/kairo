# Set to "false" to disable the WebGL hero scene.
NEXT_PUBLIC_ENABLE_3D=true

# Public application origins. Keep localhost for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# PostgreSQL and Auth.js. Generate AUTH_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATABASE_URL=postgresql://kairo:change-me@localhost:5432/kairo?schema=public
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Protects the server-only anime import endpoint.
ANIME_IMPORT_SECRET=

# Optional writable directory for normalized public anime snapshots.
KAIRO_ANIME_SNAPSHOT_DIR=

# Server-side localized title importer. Providers may be disabled independently.
ANIME_TITLES_SHIKIMORI_ENABLED=true
ANIME_TITLES_WIKIDATA_ENABLED=true
SHIKIMORI_API_BASE_URL=https://shikimori.one/api
WIKIDATA_API_BASE_URL=https://www.wikidata.org/w/api.php
ANIME_TITLES_CONCURRENCY=1
ANIME_TITLES_REQUEST_DELAY_MS=1000
ANIME_TITLES_MAX_RETRIES=4
ANIME_TITLES_REQUEST_TIMEOUT_MS=15000
ANIME_MEDIA_ALLOWED_HOSTS=storage.googleapis.com,interactive-examples.mdn.mozilla.net
ANIME_MEDIA_ALLOW_LOCALHOST=true
ANILIST_INDEX_REQUEST_DELAY_MS=1500
ANILIST_INDEX_MAX_RETRIES=5
ANILIST_INDEX_BACKOFF_BASE_MS=3000
ANILIST_INDEX_BACKOFF_MAX_MS=60000
ANILIST_INDEX_CONCURRENCY=1

# AniLiberty metadata provider. Playback remains disabled without written permission.
ANILIBERTY_PROVIDER_ENABLED=false
ANILIBERTY_API_BASE_URL=https://aniliberty.top/api/v1
ANILIBERTY_API_TOKEN=
ANILIBERTY_TIMEOUT_MS=10000
ANILIBERTY_MAX_RETRIES=3
ANILIBERTY_PLAYBACK_ENABLED=false
ANILIBERTY_ALLOWED_EMBED_HOSTS=
ANILIBERTY_ALLOWED_MEDIA_HOSTS=

# Server-only Kodik embed integration. All three values must be configured explicitly.
KODIK_PROVIDER_ENABLED=false
KODIK_API_BASE_URL=https://kodik-api.com
KODIK_API_TOKEN=
KODIK_TIMEOUT_MS=10000
KODIK_MAX_RETRIES=1
KODIK_PLAYBACK_ENABLED=false
KODIK_ALLOWED_EMBED_HOSTS=
KODIK_ALLOWED_MEDIA_HOSTS=
ABLY_API_KEY=
WATCH_PARTY_MAX_MEMBERS=10
WATCH_PARTY_HOST_GRACE_SECONDS=60

# Optional Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Explicitly opt in to development seed data.
ENABLE_DEV_SEED=false
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
