    "next": "^16.0.3",
    "next-auth": "^4.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "kodikwrapper": "^3.1.0",
    "prettier": "^3.6.2",
